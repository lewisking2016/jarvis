[TEMPLATE]
# ── JARVIS configuration ─────────────────────────────────────────────
# Brain: OpenRouter FREE pool with auto-failover (never runs out).
# The chain re-ranks against the live OpenRouter catalog every 10 min — new free
# models are adopted automatically; rate-limited/down models are skipped via a
# circuit breaker and the next free brain answers mid-turn.
OPENROUTER_API_KEY=sk-or-your_key_here

# Optional: pin a preferred model at the head of the chain (free ids end in :free).
# JARVIS_MODEL=deepseek/deepseek-v4-flash-0731:free

# Optional: hardcode the whole failover chain (comma-separated, tried in order).
# JARVIS_MODEL_CHAIN=deepseek/deepseek-v4-flash-0731:free,google/gemma-4-31b-it:free

# Optional: Google Gemini free tier runs BEFORE the OpenRouter pool if set.
# GEMINI_API_KEY=

# Optional: local endpoint (Ollama / LM Studio) — Tier 3, keeps the lights on offline.
# JARVIS_BASE_URL=http://localhost:11434/v1

# M-Pesa webhook shared secret (Android bridge / Daraja) — rotate freely
MPESA_WEBHOOK_TOKEN=change_me

# ── More free brains (any key present joins the failover pool automatically) ──
# GEMINI_API_KEY=         # aistudio.google.com — Tier 1, most generous free tier
# GROQ_API_KEY=           # console.groq.com — very fast Llama/Qwen, free tier
# CEREBRAS_API_KEY=       # cloud.cerebras.ai — free daily allowance
# GITHUB_MODELS_TOKEN=    # github.com/marketplace/models — free with a GitHub account
# MISTRAL_API_KEY=        # console.mistral.ai — free Experiment tier
# NVIDIA_API_KEY=         # build.nvidia.com — free credits
# Or self-host OmniRoute (omniroute.online) to aggregate 50+ providers free quotas,
# then point JARVIS_BASE_URL at its local OpenAI-compatible endpoint.
# ── Email (Mailbux SMTP — STARTTLS :587) ──
# SMTP_HOST=my.mailbux.com
# SMTP_PORT=587
# marketing mailbox — campaigns & outreach
# SMTP_INFO_USER=info@imeantech.com
# SMTP_INFO_PASS=
# formal mailbox — quotations, invoices, receipts
# SMTP_ADMIN_USER=admin@imeantech.com
# SMTP_ADMIN_PASS=

# ── VPS deploy (Azure) ──
JARVIS_VPS_HOST=
JARVIS_VPS_USER=jarvis
JARVIS_VPS_PASS=

# ── WhatsApp alerts (CallMeBot, free) ──
WHATSAPP_PHONE=
WHATSAPP_APIKEY=
